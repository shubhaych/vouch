{
  "name": "vouch",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Vouch World: AI refund investigation, a live SpacetimeDB shopping economy, and Droid-improved fraud detectors.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "module",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "worker": "npm run start -w worker",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck --workspaces && tsc -p .",
    "test": "npm test -w module && npm test -w worker",
    "check": "npm run typecheck && npm test && npm run check:rules",
    "check:rules": "tsx scripts/check-rules.ts",
    "stdb:start": "bash scripts/stdb-start.sh",
    "stdb:publish": "bash scripts/stdb-publish.sh",
    "stdb:generate": "bash scripts/stdb-generate.sh",
    "env:check": "tsx scripts/env-check.ts",
    "hello:stdb": "tsx scripts/hello-stdb.ts",
    "hello:creao": "tsx scripts/hello-creao.ts",
    "hello:droid": "tsx scripts/hello-droid.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "eval": "tsx detectors/eval.ts",
    "desk:book": "node --import tsx worker/src/finance/build-book.ts build",
    "desk:reconcile": "node --import tsx worker/src/finance/build-book.ts reconcile",
    "creao:check": "node --import tsx worker/src/finance/check-creao.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "dependencies": {},
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.33.0"
  }
}
