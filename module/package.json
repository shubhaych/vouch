{
  "name": "@vouch/module",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SpacetimeDB module for Vouch World: schema, reducers and the simulation engine. sim.ts and friends are pure and shared with web, worker and the detector evaluator.",
  "exports": {
    "./sim": "./src/sim.ts",
    "./simdb": "./src/simdb.ts",
    "./memdb": "./src/memdb.ts",
    "./world": "./src/world.ts",
    "./score": "./src/score.ts",
    "./text": "./src/text.ts",
    "./rng": "./src/rng.ts",
    "./review-score": "./src/review-score.ts",
    "./review-types": "./src/review-types.ts",
    "./finance/accounts": "./src/finance/accounts.ts",
    "./finance/ledger": "./src/finance/ledger.ts",
    "./finance/policy": "./src/finance/policy.ts",
    "./finance/reserve": "./src/finance/reserve.ts",
    "./finance/exposure": "./src/finance/exposure.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
