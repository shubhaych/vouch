# Vouch World environment (names only; values live in the cloud environment or a git-ignored .env).
# Copy to .env at the repo root: the worker reads it, and web/next.config.ts copies only the
# NEXT_PUBLIC_* lines into the browser build. Every key is optional for local fixture mode. Never commit .env.

# SpacetimeDB: there is no API key. Clients connect to the host; the worker makes and saves its own token.
STDB_URI=ws://localhost:3011                   # Maincloud: https://maincloud.spacetimedb.com
STDB_DB=vouch                                  # Maincloud: vouch-world
STDB_WORKER_TOKEN=                             # optional: leave empty and the worker creates one on first start (worker/.keys/)
SPACETIMEDB_LOGIN_TOKEN=                       # optional: lets a cloud session publish (spacetime login show --token)
NEXT_PUBLIC_STDB_URI=ws://localhost:3011
NEXT_PUBLIC_STDB_DB=vouch
NEXT_PUBLIC_DESK=0                           # 1 shows Finance impact on the business refund report

# Worker
WORKER_PORT=8787
NEXT_PUBLIC_WORKER_URL=http://localhost:8787   # the tunnel URL on demo day, so phones can upload
MEDIA_SIGNING_SECRET=                          # openssl rand -hex 32 (if empty, one is generated once and kept in worker/.keys/)
DEMO_BUSINESS_CODE=                            # seat code for /business (local default: vouch-business)
DEMO_CONTROLLER_CODE=                          # seat code for the controller (local default: vouch-controller)
FINANCE_DESK=0                                 # 1 opts the worker into the isolated finance portfolio and DuckDB book
FINANCE_BOOK_SEED=1
FINANCE_BOOK_PATH=worker/data/brindle.duckdb
FINANCE_CREAO_MODE=mock                        # mock until agents exist; replay or live after validation
# Finance CREAO apps: each seat has its own app ID and app-scoped API key (capi_...). Worker only.
CREAO_FINANCE_IMPACT_ANALYST_APP_ID=
CREAO_FINANCE_IMPACT_ANALYST_API_KEY=
CREAO_FINANCE_IMPACT_REVIEWER_APP_ID=
CREAO_FINANCE_IMPACT_REVIEWER_API_KEY=
CREAO_FINANCE_CLOSE_CONTROLLER_APP_ID=
CREAO_FINANCE_CLOSE_CONTROLLER_API_KEY=
CREAO_FINANCE_ADVISOR_APP_ID=
CREAO_FINANCE_ADVISOR_API_KEY=
CREAO_FINANCE_GUARDIAN_APP_ID=
CREAO_FINANCE_GUARDIAN_API_KEY=
RECORD_FINANCE_CREAO=0
ISSUER_KEYS_PATH=./worker/.keys/issuers.json   # businesses' Ed25519 private keys, created on first start, git-ignored

# CREAO account credentials for the existing Vouch shopper agents. The finance agents above use app-scoped credentials.
CREAO_API_KEY=
CREAO_EVIDENCE_ANALYST_AGENT_ID=
CREAO_REFUND_INVESTIGATOR_AGENT_ID=
CREAO_PATTERN_ANALYST_AGENT_ID=
CREAO_REFUND_REVIEWER_AGENT_ID=                # video reviewer: reads the business report, agrees or suggests another tier (optional seat)
CREAO_CUSTOMER_LIAISON_AGENT_ID=               # video reviewer: the customer-facing message (optional seat)
# Only for app-scoped capi_ keys (one agent each): the app id from each agent's page, and its key
CREAO_EVIDENCE_ANALYST_APP_ID=
CREAO_EVIDENCE_ANALYST_KEY=
CREAO_REFUND_INVESTIGATOR_APP_ID=
CREAO_REFUND_INVESTIGATOR_KEY=
CREAO_PATTERN_ANALYST_APP_ID=
CREAO_PATTERN_ANALYST_KEY=
CREAO_REFUND_REVIEWER_APP_ID=
CREAO_REFUND_REVIEWER_KEY=
CREAO_CUSTOMER_LIAISON_APP_ID=
CREAO_CUSTOMER_LIAISON_KEY=
CREAO_WEBHOOK_URL=                             # empty in the cloud (polling); tunnel URL + /creao/webhook on the laptop
CREAO_MODE=fixture                             # live only for Loop 2 live passes and the demo
CREAO_DAILY_RUN_LIMIT=40

# Factory
FACTORY_API_KEY=                               # read by the droid CLI on the worker laptop; without it the video reviewer runs automated checks only

# Video reviewer (worker/src/review): fenced Droid sessions per claim, the case folders live in worker/cases/
REVIEW_ENABLED=1                               # 0 = claims with a video go back to the Desk Lead (CREAO Evidence Analyst + Investigator)
MAX_DROID_SESSIONS_PER_HOUR=20                 # Case Analyst, Report Auditor, retries and nested vision calls all count
REVIEW_SESSION_LIMIT_MS=360000                 # a session is stopped after 6 minutes; its findings so far are kept
REVIEW_DROID_PROOF=0                           # 1 = the Proof Builder runs as a third Droid session; 0 = the worker cuts the same clips itself (no credits)
FINGER_CHECK=1                                 # 0 = skip the quick finger-challenge check at upload (one Droid image call, about 6-14 s)
REVIEW_DROID_AUDITOR=0                         # 1 = the Report Auditor runs as a Droid session (adds about 60-90 s); 0 = the worker's own audit only
REVIEW_DROID_MODEL=                            # optional model id for the review sessions (empty = the account default)
WHISPER_MODEL=small                            # bash scripts/setup-review-audio.sh installs and warms this model
REVIEW_PYTHON=                                 # optional Python executable; defaults to .venv-review/bin/python3 when installed
REVIEW_DROID_CLAIMS=0                           # 1 adds a separate model call to split claims; default lets the Case Analyst analyse the sentence split
CRS_API_KEY=                                   # optional identity verification; empty = identity unknown, a verified Vouch credential counts instead
CRS_BASE_URL=

# Simulation defaults for demo-reset
SIM_SEED=11
SIM_POPULATION=10000
