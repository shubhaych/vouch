# Vouch World environment (names only; values live in the cloud environment or a git-ignored .env).
# Every key is optional for local fixture mode. Never commit .env.

# SpacetimeDB: there is no API key. Clients connect to the host; the worker makes and saves its own token.
STDB_URI=ws://localhost:3011                   # Maincloud: https://maincloud.spacetimedb.com
STDB_DB=vouch                                  # Maincloud: vouch-world
STDB_WORKER_TOKEN=                             # optional: leave empty and the worker creates one on first start (worker/.keys/)
SPACETIMEDB_LOGIN_TOKEN=                       # optional: lets a cloud session publish (spacetime login show --token)
NEXT_PUBLIC_STDB_URI=ws://localhost:3011
NEXT_PUBLIC_STDB_DB=vouch

# Worker
WORKER_PORT=8787
NEXT_PUBLIC_WORKER_URL=http://localhost:8787   # the tunnel URL on demo day, so phones can upload
MEDIA_SIGNING_SECRET=                          # openssl rand -hex 32 (if empty, one is generated once and kept in worker/.keys/)
DEMO_BUSINESS_CODE=                            # seat code for /business (local default: vouch-business)
DEMO_CONTROLLER_CODE=                          # seat code for the controller (local default: vouch-controller)
ISSUER_KEYS_PATH=./worker/.keys/issuers.json   # businesses' Ed25519 private keys, created on first start, git-ignored

# CREAO: ONE account key (cr_sk_) runs all three agents; ids are found by agent name if left empty
CREAO_API_KEY=
CREAO_EVIDENCE_ANALYST_AGENT_ID=
CREAO_REFUND_INVESTIGATOR_AGENT_ID=
CREAO_PATTERN_ANALYST_AGENT_ID=
# Only for app-scoped capi_ keys (one agent each): the app id from each agent's page, and its key
CREAO_EVIDENCE_ANALYST_APP_ID=
CREAO_EVIDENCE_ANALYST_KEY=
CREAO_REFUND_INVESTIGATOR_APP_ID=
CREAO_REFUND_INVESTIGATOR_KEY=
CREAO_PATTERN_ANALYST_APP_ID=
CREAO_PATTERN_ANALYST_KEY=
CREAO_WEBHOOK_URL=                             # empty in the cloud (polling); tunnel URL + /creao/webhook on the laptop
CREAO_MODE=fixture                             # live only for Loop 2 live passes and the demo
CREAO_DAILY_RUN_LIMIT=40

# Factory
FACTORY_API_KEY=                               # read by the droid CLI on the worker laptop

# Simulation defaults for demo-reset
SIM_SEED=11
SIM_POPULATION=10000
