# SpacetimeDB: the only database and the live-state bus
STDB_URI=ws://localhost:3000
STDB_DB=vouch
STDB_TOKEN=

# Browser-visible copies (non-secret). The web app reads only these.
NEXT_PUBLIC_STDB_URI=ws://localhost:3000
NEXT_PUBLIC_STDB_DB=vouch

# Supporting sponsors
CRS_BASE_URL=            # (guess) from the CRS hackpack
CRS_API_KEY=
NESSIE_API_KEY=

# CREAO: one saved agent per seat (four); app id and capi_ key come from each
# agent's page. Server-side only, never in web/
CREAO_REFUND_DESK_APP_ID=
CREAO_REFUND_DESK_KEY=
CREAO_CREDIT_ANALYST_APP_ID=
CREAO_CREDIT_ANALYST_KEY=
CREAO_AGENT_ORDER_APP_ID=
CREAO_AGENT_ORDER_KEY=
CREAO_RECONCILER_APP_ID=
CREAO_RECONCILER_KEY=
CREAO_WEBHOOK_URL=       # public https URL of the worker's /creao/webhook (localhost is rejected)

# Kill switch: when false, new cases drop to Lane C with the reason "underwriter offline"
CREAO_ENABLED=true

# Worker
WORKER_PORT=8787
